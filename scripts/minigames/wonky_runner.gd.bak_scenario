extends Node2D

## WONKY RUNNER
## Endless runner de 3 carriles para móvil. Todo el escenario y UI se construyen
## por código para mantener la escena ligera y fácil de ajustar.

const VIEW_W := 1080.0
const VIEW_H := 1920.0
const VANISH_X := 540.0
const SPAWN_Y := 610.0
const END_Y := 2030.0
const PLAYER_Y := 1545.0
const LANE_X := [245.0, 540.0, 835.0]
const LANE_OFFSETS := [-315.0, 0.0, 315.0]

const TEX_BG = preload("res://imagenes/runner/background.png")
const TEX_COIN = preload("res://imagenes/runner/coin.png")
const TEX_CRATE = preload("res://imagenes/runner/crate.png")
const TEX_BARRIER = preload("res://imagenes/runner/high_barrier.png")
const TEX_SPIKE = preload("res://imagenes/runner/spike_ball.png")
const TEX_MAGNET = preload("res://imagenes/runner/magnet.png")
const TEX_SHIELD = preload("res://imagenes/runner/shield.png")
const TEX_MULTIPLIER = preload("res://imagenes/runner/multiplier.png")
const TEX_SPARKLES = preload("res://imagenes/runner/sparkles.png")
const TEX_DUST = preload("res://imagenes/runner/dust.png")
const TEX_PAUSE = preload("res://imagenes/runner/pause.png")
const TEX_GAMEOVER = preload("res://imagenes/runner/gameover_panel.png")
const TEX_RETRY = preload("res://imagenes/runner/retry.png")
const TEX_REVIVE = preload("res://imagenes/runner/revive.png")
const TEX_HOME = preload("res://imagenes/opt/navegacion/inicio.png")

const WONKY_RUN := [
	preload("res://imagenes/runner/wonky_run_01.png"),
	preload("res://imagenes/runner/wonky_run_02.png"),
	preload("res://imagenes/runner/wonky_run_03.png"),
	preload("res://imagenes/runner/wonky_run_04.png"),
	preload("res://imagenes/runner/wonky_run_05.png"),
	preload("res://imagenes/runner/wonky_run_06.png"),
	preload("res://imagenes/runner/wonky_run_07.png"),
	preload("res://imagenes/runner/wonky_run_08.png")
]
const WONKY_JUMP := [
	preload("res://imagenes/runner/wonky_jump_01.png"),
	preload("res://imagenes/runner/wonky_jump_02.png"),
	preload("res://imagenes/runner/wonky_jump_03.png")
]
const TEX_WONKY_SLIDE = preload("res://imagenes/runner/wonky_slide.png")
const TEX_WONKY_HIT = preload("res://imagenes/runner/wonky_hit.png")
const TEX_WONKY_CELEBRATE = preload("res://imagenes/runner/wonky_celebrate.png")

const ENEMY_RUN := [
	preload("res://imagenes/runner/enemy_run_01.png"),
	preload("res://imagenes/runner/enemy_run_02.png"),
	preload("res://imagenes/runner/enemy_run_03.png"),
	preload("res://imagenes/runner/enemy_run_04.png"),
	preload("res://imagenes/runner/enemy_run_05.png"),
	preload("res://imagenes/runner/enemy_run_06.png")
]
const TEX_ENEMY_STUNNED = preload("res://imagenes/runner/enemy_stunned.png")
const TEX_ENEMY_CELEBRATE = preload("res://imagenes/runner/enemy_celebrate.png")

var gm: Node = null
var world: Node2D
var background: Sprite2D
var player: AnimatedSprite2D
var enemy: AnimatedSprite2D
var dust: Sprite2D
var active_items: Array = []

var lane_index := 1
var score := 0.0
var coins_collected := 0
var elapsed := 0.0
var scroll_speed := 0.22
var spawn_clock := 0.55
var power_spawn_cooldown := 4.0
var is_game_over := false
var is_paused := false
var is_jumping := false
var is_sliding := false
var slide_time := 0.0
var hit_lock := 0.0
var danger_window := 0.0
var enemy_target_y := 1815.0
var enemy_stun_time := 0.0
var magnet_time := 0.0
var multiplier_time := 0.0
var shield_active := false
var revive_used := false
var rewards_given := false
var best_score := 0

var touch_origin := Vector2.ZERO
var touch_tracking := false
var mouse_origin := Vector2.ZERO
var mouse_tracking := false

# HUD
var score_label: Label
var coin_label: Label
var power_label: Label
var pause_button: TextureButton
var pause_overlay: Control
var game_over_overlay: Control
var final_score_label: Label
var final_best_label: Label
var final_coins_label: Label
var revive_button: TextureButton
var intro_overlay: Control

func _ready() -> void:
	randomize()
	gm = get_tree().root.get_node_or_null("GameManager")
	_load_best_score()
	_build_world()
	_build_hud()
	_start_game()

func _build_world() -> void:
	background = Sprite2D.new()
	background.texture = TEX_BG
	background.position = Vector2(VIEW_W * 0.5, VIEW_H * 0.5)
	if background.texture:
		var s := background.texture.get_size()
		if s.x > 0.0 and s.y > 0.0:
			var factor := maxf(VIEW_W / s.x, VIEW_H / s.y)
			background.scale = Vector2.ONE * factor
	background.z_index = -20
	add_child(background)

	world = Node2D.new()
	world.name = "RunnerWorld"
	add_child(world)

	# Enemigo perseguidor: está detrás de Wonky, más cerca de la cámara.
	enemy = AnimatedSprite2D.new()
	enemy.sprite_frames = _build_enemy_frames()
	enemy.animation = "run"
	enemy.position = Vector2(LANE_X[1], 1815.0)
	enemy.scale = Vector2.ONE * 0.245
	enemy.z_index = 8
	world.add_child(enemy)
	enemy.play("run")

	dust = Sprite2D.new()
	dust.texture = TEX_DUST
	dust.position = Vector2(LANE_X[1], PLAYER_Y + 115.0)
	dust.scale = Vector2.ONE * 0.13
	dust.modulate = Color(1, 1, 1, 0.22)
	dust.z_index = 9
	world.add_child(dust)

	player = AnimatedSprite2D.new()
	player.sprite_frames = _build_player_frames()
	player.animation = "run"
	player.position = Vector2(LANE_X[1], PLAYER_Y)
	player.scale = Vector2.ONE * 0.31
	player.z_index = 10
	world.add_child(player)
	player.play("run")

func _build_player_frames() -> SpriteFrames:
	var frames := SpriteFrames.new()
	frames.remove_animation("default")

	frames.add_animation("run")
	frames.set_animation_speed("run", 11.5)
	frames.set_animation_loop("run", true)
	for tex in WONKY_RUN:
		frames.add_frame("run", tex)

	frames.add_animation("jump")
	frames.set_animation_speed("jump", 5.5)
	frames.set_animation_loop("jump", false)
	for tex in WONKY_JUMP:
		frames.add_frame("jump", tex)
	frames.add_frame("jump", WONKY_JUMP[1])
	frames.add_frame("jump", WONKY_JUMP[0])

	frames.add_animation("slide")
	frames.set_animation_speed("slide", 1.0)
	frames.set_animation_loop("slide", true)
	frames.add_frame("slide", TEX_WONKY_SLIDE)

	frames.add_animation("hit")
	frames.set_animation_speed("hit", 1.0)
	frames.set_animation_loop("hit", true)
	frames.add_frame("hit", TEX_WONKY_HIT)

	frames.add_animation("celebrate")
	frames.set_animation_speed("celebrate", 1.0)
	frames.set_animation_loop("celebrate", true)
	frames.add_frame("celebrate", TEX_WONKY_CELEBRATE)
	return frames

func _build_enemy_frames() -> SpriteFrames:
	var frames := SpriteFrames.new()
	frames.remove_animation("default")
	frames.add_animation("run")
	frames.set_animation_speed("run", 9.0)
	frames.set_animation_loop("run", true)
	for tex in ENEMY_RUN:
		frames.add_frame("run", tex)
	frames.add_animation("stunned")
	frames.set_animation_speed("stunned", 1.0)
	frames.set_animation_loop("stunned", true)
	frames.add_frame("stunned", TEX_ENEMY_STUNNED)
	frames.add_animation("celebrate")
	frames.set_animation_speed("celebrate", 1.0)
	frames.set_animation_loop("celebrate", true)
	frames.add_frame("celebrate", TEX_ENEMY_CELEBRATE)
	return frames

func _build_hud() -> void:
	var canvas := CanvasLayer.new()
	canvas.name = "HUD"
	add_child(canvas)

	var root := Control.new()
	root.position = Vector2.ZERO
	root.size = Vector2(VIEW_W, VIEW_H)
	root.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	root.mouse_filter = Control.MOUSE_FILTER_PASS
	canvas.add_child(root)

	# Faja superior muy ligera para que las cifras se lean sobre cualquier fondo.
	var top_bg := ColorRect.new()
	top_bg.color = Color(0.08, 0.05, 0.02, 0.18)
	top_bg.position = Vector2(0, 0)
	top_bg.size = Vector2(VIEW_W, 185)
	top_bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	root.add_child(top_bg)

	coin_label = _make_hud_label("0", Vector2(54, 45), Vector2(270, 100), 45, HORIZONTAL_ALIGNMENT_LEFT)
	root.add_child(coin_label)
	var coin_icon := TextureRect.new()
	coin_icon.texture = TEX_COIN
	coin_icon.position = Vector2(18, 50)
	coin_icon.size = Vector2(64, 64)
	coin_icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	coin_icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	coin_icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	root.add_child(coin_icon)
	coin_label.position.x = 83

	score_label = _make_hud_label("0", Vector2(355, 38), Vector2(370, 110), 54, HORIZONTAL_ALIGNMENT_CENTER)
	root.add_child(score_label)

	power_label = _make_hud_label("", Vector2(260, 125), Vector2(560, 55), 26, HORIZONTAL_ALIGNMENT_CENTER)
	power_label.add_theme_color_override("font_color", Color("#FFF4B6"))
	root.add_child(power_label)

	pause_button = TextureButton.new()
	pause_button.texture_normal = TEX_PAUSE
	pause_button.ignore_texture_size = true
	pause_button.stretch_mode = TextureButton.STRETCH_KEEP_ASPECT_CENTERED
	pause_button.position = Vector2(925, 35)
	pause_button.size = Vector2(110, 110)
	pause_button.focus_mode = Control.FOCUS_NONE
	pause_button.pressed.connect(_toggle_pause)
	root.add_child(pause_button)

	_build_pause_overlay(root)
	_build_game_over_overlay(root)
	_build_intro_overlay(root)

func _make_hud_label(text_value: String, pos: Vector2, size_value: Vector2, font_size: int, align: int) -> Label:
	var label := Label.new()
	label.text = text_value
	label.position = pos
	label.size = size_value
	label.horizontal_alignment = align
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.add_theme_font_size_override("font_size", font_size)
	label.add_theme_color_override("font_color", Color.WHITE)
	label.add_theme_color_override("font_outline_color", Color("#4A210F"))
	label.add_theme_constant_override("outline_size", 8)
	label.add_theme_color_override("font_shadow_color", Color(0, 0, 0, 0.25))
	label.add_theme_constant_override("shadow_offset_y", 3)
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return label

func _build_pause_overlay(root: Control) -> void:
	pause_overlay = Control.new()
	pause_overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	pause_overlay.visible = false
	pause_overlay.z_index = 80
	root.add_child(pause_overlay)

	var dim := ColorRect.new()
	dim.color = Color(0.03, 0.02, 0.02, 0.68)
	dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	pause_overlay.add_child(dim)

	var title := _make_hud_label("PAUSA", Vector2(240, 650), Vector2(600, 120), 72, HORIZONTAL_ALIGNMENT_CENTER)
	pause_overlay.add_child(title)

	var resume := Button.new()
	resume.text = "CONTINUAR"
	resume.position = Vector2(310, 835)
	resume.size = Vector2(460, 125)
	resume.add_theme_font_size_override("font_size", 42)
	resume.add_theme_color_override("font_color", Color.WHITE)
	resume.add_theme_color_override("font_outline_color", Color("#5B2C12"))
	resume.add_theme_constant_override("outline_size", 6)
	resume.pressed.connect(_toggle_pause)
	pause_overlay.add_child(resume)

	var home := Button.new()
	home.text = "SALIR AL MENÚ"
	home.position = Vector2(310, 990)
	home.size = Vector2(460, 105)
	home.add_theme_font_size_override("font_size", 32)
	home.pressed.connect(_leave_to_menu)
	pause_overlay.add_child(home)

