	game_over_overlay = Control.new()
	game_over_overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	game_over_overlay.visible = false
	game_over_overlay.z_index = 100
	root.add_child(game_over_overlay)

	var dim := ColorRect.new()
	dim.color = Color(0.04, 0.02, 0.01, 0.66)
	dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	game_over_overlay.add_child(dim)

	var panel := TextureRect.new()
	panel.texture = TEX_GAMEOVER
	panel.position = Vector2(75, 300)
	panel.size = Vector2(930, 1260)
	panel.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	panel.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	game_over_overlay.add_child(panel)

	var title := _make_hud_label("FIN DE LA CARRERA", Vector2(175, 505), Vector2(730, 100), 52, HORIZONTAL_ALIGNMENT_CENTER)
	title.add_theme_color_override("font_color", Color("#FFCC43"))
	game_over_overlay.add_child(title)

	final_score_label = _make_hud_label("PUNTOS 0", Vector2(205, 680), Vector2(670, 80), 42, HORIZONTAL_ALIGNMENT_CENTER)
	final_best_label = _make_hud_label("RÉCORD 0", Vector2(205, 790), Vector2(670, 80), 36, HORIZONTAL_ALIGNMENT_CENTER)
	final_coins_label = _make_hud_label("MONEDAS +0", Vector2(205, 900), Vector2(670, 80), 36, HORIZONTAL_ALIGNMENT_CENTER)
	game_over_overlay.add_child(final_score_label)
	game_over_overlay.add_child(final_best_label)
	game_over_overlay.add_child(final_coins_label)

	var retry_btn := _make_texture_button(TEX_RETRY, Vector2(165, 1125), Vector2(200, 200))
	retry_btn.pressed.connect(_restart_from_game_over)
	game_over_overlay.add_child(retry_btn)
	var retry_text := _make_hud_label("REINTENTAR", Vector2(125, 1320), Vector2(280, 55), 25, HORIZONTAL_ALIGNMENT_CENTER)
	game_over_overlay.add_child(retry_text)

	revive_button = _make_texture_button(TEX_REVIVE, Vector2(440, 1125), Vector2(200, 200))
	revive_button.pressed.connect(_revive)
	game_over_overlay.add_child(revive_button)
	var revive_text := _make_hud_label("REVIVIR", Vector2(400, 1320), Vector2(280, 55), 25, HORIZONTAL_ALIGNMENT_CENTER)
	game_over_overlay.add_child(revive_text)

	var home_btn := _make_texture_button(TEX_HOME, Vector2(715, 1135), Vector2(185, 185))
	home_btn.pressed.connect(_leave_to_menu)
	game_over_overlay.add_child(home_btn)
	var home_text := _make_hud_label("MENÚ", Vector2(675, 1320), Vector2(270, 55), 25, HORIZONTAL_ALIGNMENT_CENTER)
	game_over_overlay.add_child(home_text)

func _make_texture_button(tex: Texture2D, pos: Vector2, size_value: Vector2) -> TextureButton:
	var button := TextureButton.new()
	button.texture_normal = tex
	button.ignore_texture_size = true
	button.stretch_mode = TextureButton.STRETCH_KEEP_ASPECT_CENTERED
	button.position = pos
	button.size = size_value
	button.focus_mode = Control.FOCUS_NONE
	return button

func _build_intro_overlay(root: Control) -> void:
	intro_overlay = Control.new()
	intro_overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	intro_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
	intro_overlay.z_index = 70
	root.add_child(intro_overlay)

	var box := ColorRect.new()
	box.color = Color(0.04, 0.025, 0.01, 0.64)
	box.position = Vector2(95, 630)
	box.size = Vector2(890, 420)
	box.mouse_filter = Control.MOUSE_FILTER_IGNORE
	intro_overlay.add_child(box)

	var title := _make_hud_label("¡CORRE, WONKY!", Vector2(140, 675), Vector2(800, 95), 54, HORIZONTAL_ALIGNMENT_CENTER)
	intro_overlay.add_child(title)
	var help := _make_hud_label("←  DESLIZA A LOS LADOS  →\n↑  SALTA     ·     ↓  DESLÍZATE", Vector2(130, 785), Vector2(820, 150), 29, HORIZONTAL_ALIGNMENT_CENTER)
	help.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	intro_overlay.add_child(help)

func _start_game() -> void:
	for item in active_items:
		if is_instance_valid(item):
			item.queue_free()
	active_items.clear()

	lane_index = 1
	score = 0.0
	coins_collected = 0
	elapsed = 0.0
	scroll_speed = 0.22
	spawn_clock = 0.60
	power_spawn_cooldown = 3.5
	is_game_over = false
	is_paused = false
	is_jumping = false
	is_sliding = false
	slide_time = 0.0
	hit_lock = 0.0
	danger_window = 0.0
	enemy_target_y = 1815.0
	enemy_stun_time = 0.0
	magnet_time = 0.0
	multiplier_time = 0.0
	shield_active = false
	revive_used = false
	rewards_given = false

	player.position = Vector2(LANE_X[1], PLAYER_Y)
	player.rotation = 0.0
	player.scale = Vector2.ONE * 0.31
	player.modulate = Color.WHITE
	player.play("run")
	enemy.position = Vector2(LANE_X[1], 1815.0)
	enemy.scale = Vector2.ONE * 0.245
	enemy.modulate = Color.WHITE
	enemy.play("run")
	dust.position = Vector2(LANE_X[1], PLAYER_Y + 115.0)

	pause_overlay.visible = false
	game_over_overlay.visible = false
	revive_button.modulate = Color.WHITE
	revive_button.mouse_filter = Control.MOUSE_FILTER_STOP
	intro_overlay.visible = true
	_update_hud()

	var tween := create_tween()
	tween.tween_interval(1.8)
	tween.tween_property(intro_overlay, "modulate:a", 0.0, 0.35)
	tween.finished.connect(func():
		intro_overlay.visible = false
		intro_overlay.modulate.a = 1.0
	)

func _process(delta: float) -> void:
	if is_paused or is_game_over:
		return

	elapsed += delta
	hit_lock = maxf(0.0, hit_lock - delta)
	power_spawn_cooldown = maxf(0.0, power_spawn_cooldown - delta)
	magnet_time = maxf(0.0, magnet_time - delta)
	multiplier_time = maxf(0.0, multiplier_time - delta)
	enemy_stun_time = maxf(0.0, enemy_stun_time - delta)

	if danger_window > 0.0:
		danger_window -= delta
		if danger_window <= 0.0:
			danger_window = 0.0
			enemy_target_y = 1815.0

	if is_sliding:
		slide_time -= delta
		if slide_time <= 0.0:
			_finish_slide()

	# Dificultad progresiva: más velocidad y apariciones frecuentes.
	scroll_speed = minf(0.39, 0.22 + elapsed * 0.0018)
	var multi := 2.0 if multiplier_time > 0.0 else 1.0
	score += delta * (18.0 + elapsed * 0.09) * multi

	spawn_clock -= delta
	if spawn_clock <= 0.0:
		_spawn_pattern()
		spawn_clock = maxf(0.46, 0.92 - elapsed * 0.0045)

	_update_items(delta)
	_update_enemy(delta)
	_update_dust(delta)
	_update_hud()

func _update_enemy(delta: float) -> void:
	if enemy_stun_time <= 0.0 and danger_window <= 0.0 and enemy_target_y > 1815.0:
		enemy_target_y = 1815.0
	enemy.position.x = lerpf(enemy.position.x, player.position.x, delta * 3.5)
	enemy.position.y = lerpf(enemy.position.y, enemy_target_y, delta * 4.2)
	if enemy_stun_time <= 0.0 and enemy.animation == "stunned":
		enemy.play("run")

func _update_dust(delta: float) -> void:
	dust.position.x = lerpf(dust.position.x, player.position.x, delta * 12.0)
	dust.position.y = PLAYER_Y + 118.0
	dust.modulate.a = 0.12 + 0.08 * (0.5 + 0.5 * sin(elapsed * 12.0))
	dust.visible = not is_jumping and not is_sliding and hit_lock <= 0.0

func _spawn_pattern() -> void:
	var roll := randf()
	if roll < 0.50:
		_spawn_coin_line()
	elif roll < 0.82:
		_spawn_obstacle_pattern()
	else:
		if power_spawn_cooldown <= 0.0:
			_spawn_powerup()
			power_spawn_cooldown = randf_range(5.5, 8.5)
		else:
			_spawn_coin_line()

func _spawn_coin_line() -> void:
	var lane := randi_range(0, 2)
	var count := randi_range(3, 5)
	for i in range(count):
		_spawn_item("coin", lane, -float(i) * 0.085)

func _spawn_obstacle_pattern() -> void:
	var lane_a := randi_range(0, 2)
	var kind_a := _random_obstacle()
	_spawn_item(kind_a, lane_a, 0.0)

	# Después de unos segundos pueden cerrarse dos carriles, nunca los tres.
	if elapsed > 24.0 and randf() < 0.28:
		var options := [0, 1, 2]
		options.erase(lane_a)
		var lane_b: int = int(options[randi_range(0, options.size() - 1)])
		_spawn_item(_random_obstacle(), lane_b, -0.025)
		var free_lane := 3 - lane_a - int(lane_b)
		_spawn_item("coin", free_lane, -0.06)
		_spawn_item("coin", free_lane, -0.15)

func _random_obstacle() -> String:
	var r := randf()
	if r < 0.42:
		return "crate"
	if r < 0.72:
		return "spike"
	return "barrier"

func _spawn_powerup() -> void:
	var lane := randi_range(0, 2)
	var kinds := ["magnet", "shield", "multiplier"]
	var power_kind: String = str(kinds[randi_range(0, kinds.size() - 1)])
	_spawn_item(power_kind, lane, 0.0)

func _spawn_item(kind: String, lane: int, start_progress: float) -> void:
	var holder := Node2D.new()
	holder.name = "RunnerItem_" + kind
	holder.set_meta("kind", kind)
	holder.set_meta("lane", lane)
	holder.set_meta("p", start_progress)
	holder.set_meta("resolved", false)
	holder.set_meta("final_scale", _final_scale_for(kind))

	var sprite := Sprite2D.new()
	sprite.texture = _texture_for(kind)
	sprite.name = "Sprite"
	holder.add_child(sprite)
	world.add_child(holder)
	active_items.append(holder)
	if start_progress < 0.0:
		holder.visible = false

func _texture_for(kind: String) -> Texture2D:
	match kind:
		"coin": return TEX_COIN
		"crate": return TEX_CRATE
		"spike": return TEX_SPIKE
		"barrier": return TEX_BARRIER
		"magnet": return TEX_MAGNET
		"shield": return TEX_SHIELD
		"multiplier": return TEX_MULTIPLIER
	return TEX_COIN

func _final_scale_for(kind: String) -> float:
	match kind:
		"coin": return 0.080
		"crate": return 0.31
		"spike": return 0.27
		"barrier": return 0.34
		"magnet", "shield", "multiplier": return 0.19
	return 0.2

func _update_items(delta: float) -> void:
	for item in active_items.duplicate():
		if not is_instance_valid(item):
			active_items.erase(item)
			continue

		var p := float(item.get_meta("p")) + delta * scroll_speed
		item.set_meta("p", p)
		if p < 0.0:
			item.visible = false
			continue
		item.visible = true

		var t := clampf(p, 0.0, 1.0)
		var perspective := pow(t, 0.98)
		var lane := int(item.get_meta("lane"))
		var y := lerpf(SPAWN_Y, END_Y, pow(t, 1.08))
		var x: float = VANISH_X + float(LANE_OFFSETS[lane]) * perspective
		item.position = Vector2(x, y)
		var final_scale := float(item.get_meta("final_scale"))
		var current_scale := lerpf(final_scale * 0.15, final_scale, perspective)
		# Las texturas fuente son grandes (1254 px). La moneda debe verse como
		# un pickup pequeño, no crecer hasta cubrir el carril/pantalla.
		if str(item.get_meta("kind")) == "coin":
			current_scale = minf(current_scale, 0.080)
		item.scale = Vector2.ONE * current_scale
		item.z_index = int(2 + y / 135.0)

		var kind := str(item.get_meta("kind"))
		var spr := item.get_node_or_null("Sprite") as Sprite2D
		if spr:
			if kind == "coin":
				spr.rotation += delta * 3.8
			elif kind == "spike":
				spr.rotation += delta * 0.9
			elif kind == "magnet" or kind == "shield" or kind == "multiplier":
				spr.rotation = sin(elapsed * 4.5 + float(lane)) * 0.08

		if magnet_time > 0.0 and kind == "coin" and p > 0.28 and not bool(item.get_meta("resolved")):
			_collect_item(item)
			continue

		if p >= 0.665 and p <= 0.77 and lane == lane_index and not bool(item.get_meta("resolved")):
			_resolve_contact(item)

		if p > 1.02:
			_remove_item(item)

func _resolve_contact(item: Node2D) -> void:
	item.set_meta("resolved", true)
	var kind := str(item.get_meta("kind"))
	match kind:
		"coin":
			_collect_item(item)
		"magnet", "shield", "multiplier":
			_collect_powerup(item, kind)
		"crate", "spike":
			if not is_jumping:
				_crash()
		"barrier":
			if not is_sliding:
				_crash()

func _collect_item(item: Node2D) -> void:
	if not is_instance_valid(item):
		return
	item.set_meta("resolved", true)
	coins_collected += 1
	var multi := 2 if multiplier_time > 0.0 else 1
	score += 24.0 * float(multi)
	_spawn_pickup_fx(item.position)
	_remove_item(item)

func _collect_powerup(item: Node2D, kind: String) -> void:
	if not is_instance_valid(item):
		return
	_spawn_pickup_fx(item.position)
	match kind:
		"magnet":
			magnet_time = 8.0
		"shield":
			shield_active = true
		"multiplier":
			multiplier_time = 9.0
	_remove_item(item)

func _spawn_pickup_fx(pos: Vector2) -> void:
	var fx := Sprite2D.new()
	fx.texture = TEX_SPARKLES
	fx.position = pos
	fx.scale = Vector2.ONE * 0.055
	fx.modulate = Color(1, 1, 1, 0.85)
	fx.z_index = 30
	world.add_child(fx)
	var tw := create_tween()
	tw.set_parallel(true)
	tw.tween_property(fx, "scale", Vector2.ONE * 0.095, 0.30).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw.tween_property(fx, "modulate:a", 0.0, 0.34)
	tw.finished.connect(fx.queue_free)

func _remove_item(item: Node2D) -> void:
	active_items.erase(item)
	if is_instance_valid(item):
		item.queue_free()

func _crash() -> void:
	if hit_lock > 0.0 or is_game_over:
		return

	if shield_active:
		shield_active = false
		hit_lock = 0.9
		enemy.play("stunned")
		enemy_stun_time = 0.9
		enemy_target_y = 1860.0
		_flash_player(Color(1.0, 0.95, 0.45, 1.0))
		return

	hit_lock = 1.35
	player.play("hit")
	_flash_player(Color(1.0, 0.72, 0.72, 1.0))

	if danger_window > 0.0:
		_trigger_game_over()
		return

	danger_window = 6.0
	enemy_target_y = 1685.0
	score = maxf(0.0, score - 35.0)
	var tw := create_tween()
	tw.tween_interval(0.70)
	tw.finished.connect(func():
		if not is_game_over and not is_jumping and not is_sliding:
			player.play("run")
	)

func _flash_player(color_value: Color) -> void:
	player.modulate = color_value
	var tw := create_tween()
	tw.tween_property(player, "modulate", Color.WHITE, 0.35)

func _trigger_game_over() -> void:
	if is_game_over:
		return
	is_game_over = true
	is_jumping = false
	is_sliding = false
	player.position.y = PLAYER_Y
	player.play("hit")
	enemy_target_y = 1640.0
	enemy.play("celebrate")

	var final_score := int(score)
	if final_score > best_score:
		best_score = final_score
		_save_best_score()

	final_score_label.text = "PUNTOS  " + str(final_score)
	final_best_label.text = "RÉCORD  " + str(best_score)
	var bonus := int(float(final_score) / 280.0)
	final_coins_label.text = "MONEDAS  +" + str(coins_collected + bonus)
	revive_button.modulate = Color(1, 1, 1, 0.38) if revive_used else Color.WHITE
	revive_button.mouse_filter = Control.MOUSE_FILTER_IGNORE if revive_used else Control.MOUSE_FILTER_STOP
	game_over_overlay.visible = true
	game_over_overlay.modulate.a = 0.0
	var tw := create_tween()
	tw.tween_property(game_over_overlay, "modulate:a", 1.0, 0.22)

func _revive() -> void:
	if not is_game_over or revive_used:
		return
	revive_used = true
	is_game_over = false
	game_over_overlay.visible = false
	danger_window = 0.0
	hit_lock = 1.8
	enemy_target_y = 1860.0
	enemy.play("stunned")
	enemy_stun_time = 1.0
	player.position.y = PLAYER_Y
	player.play("run")
	_clear_near_player()

func _clear_near_player() -> void:
	for item in active_items.duplicate():
		if not is_instance_valid(item):
			continue
		var p := float(item.get_meta("p"))
		if p > 0.48:
			_remove_item(item)

func _restart_from_game_over() -> void:
	_award_rewards()
	_start_game()

func _leave_to_menu() -> void:
	_award_rewards()
	get_tree().change_scene_to_file.call_deferred("res://scenes/minigames/minigames_menu.tscn")

func _award_rewards() -> void:
	if rewards_given:
		return
	rewards_given = true
	if gm:
		var earned := coins_collected + int(score / 280.0)
		if earned > 0:
			gm.add_coins(earned)
		gm.play_with_monky(28.0)
		gm.add_xp(minf(score / 110.0, 24.0))
		if gm.has_method("save_game"):
			gm.save_game()

func _toggle_pause() -> void:
	if is_game_over:
		return
	is_paused = not is_paused
	pause_overlay.visible = is_paused
	if is_paused:
		player.pause()
		enemy.pause()
	else:
		if is_sliding:
			player.play("slide")
		elif is_jumping:
			player.play("jump")
		elif hit_lock > 0.0:
			player.play("hit")
		else:
			player.play("run")
		if enemy_stun_time > 0.0:
			enemy.play("stunned")
		else:
			enemy.play("run")

func _update_hud() -> void:
	if score_label:
		score_label.text = str(int(score))
	if coin_label:
		coin_label.text = str(coins_collected)
	if power_label:
		var parts: Array = []
		if magnet_time > 0.0:
			parts.append("IMÁN " + str(int(ceil(magnet_time))) + "s")
		if shield_active:
			parts.append("ESCUDO")
		if multiplier_time > 0.0:
			parts.append("x2 " + str(int(ceil(multiplier_time))) + "s")
		power_label.text = "  ·  ".join(parts)

func _input(event: InputEvent) -> void:
	if is_game_over or is_paused:
		return

	if event is InputEventKey and event.pressed and not event.echo:
		match event.keycode:
			KEY_LEFT, KEY_A:
				_change_lane(-1)
			KEY_RIGHT, KEY_D:
				_change_lane(1)
			KEY_UP, KEY_W, KEY_SPACE:
				_jump()
			KEY_DOWN, KEY_S:
				_slide()

	if event is InputEventScreenTouch:
		if event.pressed:
			touch_origin = event.position
			touch_tracking = true
		else:
			if touch_tracking:
				_handle_swipe(event.position - touch_origin)
			touch_tracking = false
	elif event is InputEventScreenDrag and touch_tracking:
		var drag_event := event as InputEventScreenDrag
		var diff: Vector2 = drag_event.position - touch_origin
		if diff.length() > 105.0:
			_handle_swipe(diff)
			touch_tracking = false

	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed:
			mouse_origin = event.position
			mouse_tracking = true
		else:
			if mouse_tracking:
				_handle_swipe(event.position - mouse_origin)
			mouse_tracking = false

func _handle_swipe(delta_swipe: Vector2) -> void:
	if delta_swipe.length() < 55.0:
		return
	if absf(delta_swipe.x) > absf(delta_swipe.y):
		_change_lane(-1 if delta_swipe.x < 0.0 else 1)
	else:
		if delta_swipe.y < 0.0:
			_jump()
		else:
			_slide()

func _change_lane(direction: int) -> void:
	if is_game_over:
		return
	var new_lane := clampi(lane_index + direction, 0, 2)
	if new_lane == lane_index:
		return
	lane_index = new_lane
	var target_x: float = float(LANE_X[lane_index])
	var tilt := -0.11 if direction < 0 else 0.11
	var tw := create_tween()
	tw.set_parallel(true)
	tw.tween_property(player, "position:x", target_x, 0.15).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_property(player, "rotation", tilt, 0.08)
	var dust_tw := create_tween()
	dust_tw.tween_property(dust, "position:x", target_x, 0.18).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	var reset := create_tween()
	reset.tween_interval(0.09)
	reset.tween_property(player, "rotation", 0.0, 0.10)

func _jump() -> void:
	if is_jumping or is_sliding or hit_lock > 0.0 or is_game_over:
		return
	is_jumping = true
	player.play("jump")
	var tw := create_tween()
	tw.tween_property(player, "position:y", PLAYER_Y - 275.0, 0.30).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_property(player, "position:y", PLAYER_Y, 0.34).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tw.finished.connect(_finish_jump)

func _finish_jump() -> void:
	is_jumping = false
	player.position.y = PLAYER_Y
	if not is_game_over and not is_sliding and hit_lock <= 0.0:
		player.play("run")

func _slide() -> void:
	if is_sliding or is_jumping or hit_lock > 0.0 or is_game_over:
		return
	is_sliding = true
	slide_time = 0.72
	player.position.y = PLAYER_Y + 70.0
	player.play("slide")

func _finish_slide() -> void:
	is_sliding = false
	player.position.y = PLAYER_Y
	if not is_game_over and not is_jumping and hit_lock <= 0.0:
		player.play("run")

func _load_best_score() -> void:
	var cfg := ConfigFile.new()
	if cfg.load("user://wonky_runner.cfg") == OK:
		best_score = int(cfg.get_value("runner", "best_score", 0))

func _save_best_score() -> void:
	var cfg := ConfigFile.new()
	cfg.set_value("runner", "best_score", best_score)
	cfg.save("user://wonky_runner.cfg")
